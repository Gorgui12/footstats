# Persistance des données football synchronisées (SQLite via node:sqlite,
# Node >= 22.5). Le fichier est créé automatiquement à `./data/footstats.db`
# si la variable n'est pas définie — voir DECISIONS.md D14.
# SQLITE_PATH=./data/footstats.db

# Fournisseur de données football
# - mock : données de démonstration (par défaut)
# - football-data : football-data.org (grandes compétitions Europe/International,
#   plan gratuit = 10 req/min, aucune compétition africaine) combiné avec le
#   mock provider pour Ligue 1 Sénégal / CAN (toujours marquées DEMO) — voir
#   DECISIONS.md D9 et src/providers/football/composite/.
# - api-football : API-FOOTBALL (api-sports) — source réelle couvrant l'Afrique
#   (CAN via leagues.ts, championnats locaux à ajouter) + grandes compétitions
#   européennes. Plan Free = 100 requêtes/jour. Les ids de ligues se configurent
#   dans src/providers/football/api-football/leagues.ts (dashboard :
#   https://dashboard.api-football.com) — voir DECISIONS.md D13.
FOOTBALL_PROVIDER=api-football
FOOTBALL_API_KEY=
APIFOOTBALL_API_KEY=

# IA (optionnel, feature flag ENABLE_AI_ASSISTANT)
AI_API_KEY=

# Notifications futures
TELEGRAM_BOT_TOKEN=

NODE_ENV=development
